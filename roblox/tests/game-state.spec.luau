local State = require("../src/shared/GameState")
local Rules = require("../src/shared/Rules")

local passed = 0
local function test(name, run)
	local ok, problem = pcall(run)
	if not ok then
		error(name .. ": " .. tostring(problem), 0)
	end
	passed += 1
	print("PASS " .. name)
end

local function engine()
	local state = State.new()
	state:addPlayer(1)
	state:addPlayer(2)
	state:addPlayer(3)
	return state
end

test("profiles sanitize malformed saved data and preserve existing profiles", function()
	local state = State.new()
	local profile = state:addPlayer(1, { Coins = -10, Wins = math.huge, SpeedLevel = 99, BestHeight = 6.9 })
	assert(profile.Coins == 0 and profile.Wins == 0)
	assert(profile.SpeedLevel == 3 and profile.BestHeight == 6)
	assert(state:addPlayer(1, { Coins = 999 }) == profile)
	assert(profile.Coins == 0)
	local capped = state:addPlayer(2, { Coins = 2e9, Wins = 2e9, BestHeight = 1e9 })
	assert(capped.Coins == 1e9 and capped.Wins == 1e9 and capped.BestHeight == 10000)
	local malformed = state:addPlayer(3, { Coins = "500", Wins = 0 / 0, SpeedLevel = -1 })
	assert(malformed.Coins == 0 and malformed.Wins == 0 and malformed.SpeedLevel == 0)
	assert(state:addPlayer(4, "bad").Coins == 0)
end)

test("lobby players cannot collect, dash, escape, die or gain height", function()
	local state = engine()
	assert(not state.active)
	assert(not state:collect(1, "a"))
	assert(not state:dash(1, 10))
	assert(not state:escape(1, 10))
	assert(not state:eliminate(1, 10))
	state:recordHeight(1, 100)
	assert(state.profiles[1].BestHeight == 0)
	assert(next(state:finishRound(100)) == nil)
end)

test("a round settles escape, survival and early-death rewards once", function()
	local state = engine()
	state:startRound({ 1, 2, 3 }, 100)
	assert(state:collect(1, "crystal-1"))
	assert(state:escape(1, 130))
	assert(not state:escape(1, 131))
	assert(state:eliminate(2, 120))
	assert(state:eliminate(3, 119.9))
	local rewards = state:finishRound(195)
	assert(rewards[1] == 30 and rewards[2] == 5 and rewards[3] == 0)
	assert(state.profiles[1].Coins == 33 and state.profiles[1].Wins == 1)
	assert(state.profiles[2].Coins == 5 and state.profiles[2].Wins == 0)
	assert(state.profiles[3].Coins == 0)
	assert(next(state:finishRound(200)) == nil)
	assert(state.profiles[1].Wins == 1 and state.profiles[1].Coins == 33)
end)

test("each player can collect each crystal once while alive", function()
	local state = engine()
	state:startRound({ 1, 2 }, 0)
	assert(state:collect(1, "a"))
	assert(not state:collect(1, "a"))
	assert(state:collect(2, "a"))
	assert(state:collect(1, "b"))
	assert(state.profiles[1].Coins == Rules.CoinValue * 2)
	assert(not state:collect(3, "a"))
	assert(not state:collect(1, nil))
	state:eliminate(1, 15)
	assert(not state:collect(1, "c"))
	state:finishRound(95)
	assert(not state:collect(2, "b"))
end)

test("dash cooldown is authoritative and rejects nonfinite time", function()
	local state = engine()
	state:startRound({ 1, 2 }, 100)
	assert(state:dash(1, 100))
	assert(not state:dash(1, 100))
	assert(not state:dash(1, 103.999))
	assert(state:dash(1, 104))
	assert(not state:dash(1, 0 / 0))
	assert(not state:dash(1, math.huge))
	assert(state:dash(2, 100))
	state:escape(2, 101)
	assert(not state:dash(2, 105))
end)

test("upgrade purchases use exact prices and stop at the maximum", function()
	local state = State.new()
	local profile = state:addPlayer(1, { Coins = 29 })
	assert(not state:upgrade(1))
	assert(profile.Coins == 29 and profile.SpeedLevel == 0)
	profile.Coins = 205
	assert(state:upgrade(1))
	assert(profile.Coins == 175 and profile.SpeedLevel == 1)
	assert(state:upgrade(1))
	assert(profile.Coins == 110 and profile.SpeedLevel == 2)
	assert(state:upgrade(1))
	assert(profile.Coins == 0 and profile.SpeedLevel == 3)
	profile.Coins = 999
	assert(not state:upgrade(1) and profile.Coins == 999)
	assert(not state:upgrade(2))
end)

test("height records are bounded, monotonic and require a living participant", function()
	local state = engine()
	state:startRound({ 1 }, 0)
	state:recordHeight(1, 25.9)
	state:recordHeight(1, 10)
	assert(state.profiles[1].BestHeight == 25)
	state:recordHeight(1, 0 / 0)
	state:recordHeight(1, math.huge)
	assert(state.profiles[1].BestHeight == 25)
	state:recordHeight(1, 20000)
	assert(state.profiles[1].BestHeight == 10000)
	state:eliminate(1, 10)
	state:recordHeight(2, 99)
	assert(state.profiles[2].BestHeight == 0)
end)

test("joining mid-round waits for the next round and removal removes eligibility", function()
	local state = engine()
	state:startRound({ 1, 2, 999 }, 0)
	assert(state:getParticipant(999) == nil)
	state:addPlayer(4)
	assert(state:getParticipant(4) == nil)
	assert(not state:collect(4, "a"))
	state:removePlayer(2)
	assert(state.profiles[2] == nil and state:getParticipant(2) == nil)
	local rewards = state:finishRound(95)
	assert(rewards[1] == 5 and rewards[2] == nil and rewards[4] == nil)
	state:startRound({ 1, 4 }, 100)
	assert(state:getParticipant(4).Alive)
end)

test("new rounds reset crystals, dash, escape and death while retaining progression", function()
	local state = engine()
	state:startRound({ 1, 2 }, 0)
	state:collect(1, "a")
	state:dash(1, 0)
	state:escape(1, 10)
	state:eliminate(2, 10)
	state:finishRound(95)
	state:startRound({ 1, 2 }, 100)
	local participant = state:getParticipant(1)
	assert(participant.Alive and not participant.Escaped and participant.EndedAt == nil)
	assert(participant.StartedAt == 100)
	assert(state:collect(1, "a"))
	assert(state:dash(1, 100))
	assert(state:getParticipant(2).Alive)
	assert(state.profiles[1].Coins == 36 and state.profiles[1].Wins == 1)
end)

test("currency and wins stay within persistence caps after rewards", function()
	local state = State.new()
	local profile = state:addPlayer(1, { Coins = 1e9 - 1, Wins = 1e9 })
	state:startRound({ 1 }, 0)
	state:collect(1, "a")
	assert(profile.Coins == 1e9)
	state:escape(1, 40)
	state:finishRound(95)
	assert(profile.Coins == 1e9 and profile.Wins == 1e9)
end)

print(string.format("%d game-state tests passed", passed))
